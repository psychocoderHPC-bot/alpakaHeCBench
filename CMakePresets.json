{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "alpakaHeCBench_USE_SOURCE_TREE": "ON",
        "alpakaHeCBench_ENABLE_CUDA": "OFF",
        "alpaka_TESTS": "OFF",
        "alpaka_EXAMPLES": "OFF",
        "alpaka_DOCS": "OFF",
        "alpaka_BENCHMARKS": "OFF",
        "alpakaHeCBench_FAST_MATH": "OFF"
      }
    },
    {
      "name": "cpu",
      "displayName": "CPU with the OpenMP block executor (OMP_NUM_THREADS=64)",
      "inherits": "base",
      "cacheVariables": {
        "alpaka_DEP_OMP": "ON",
        "CMAKE_CXX_FLAGS": "-march=native"
      },
      "environment": {
        "OMP_NUM_THREADS": "64"
      }
    },
    {
      "name": "cpu-serial",
      "displayName": "CPU serial executor (no OpenMP)",
      "inherits": "base",
      "cacheVariables": {
        "alpaka_DEP_OMP": "OFF",
        "CMAKE_CXX_FLAGS": "-march=native"
      }
    },
    {
      "name": "cuda",
      "displayName": "CUDA backend (A30 / sm_80)",
      "inherits": "base",
      "cacheVariables": {
        "alpakaHeCBench_ENABLE_CUDA": "ON",
        "alpaka_DEP_CUDA": "ON",
        "CMAKE_CUDA_ARCHITECTURES": "80"
      }
    },
    {
      "name": "cpu-icpx",
      "displayName": "CPU host OpenMP built with icpx (-march=native, no fast math)",
      "description": "CPU/OpenMP host executor compiled with Intel icpx, matching the ORNL cross-omp CPU pairing. Knobs: -DALPAKA_HECBENCH_ICX (icpx path), -DALPAKA_HECBENCH_ONEAPI_ROOT (oneAPI root).",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "$env{ALPAKA_HECBENCH_ICX}",
        "CMAKE_CXX_FLAGS": "-march=native",
        "alpaka_DEP_OMP": "ON",
        "alpaka_DEP_CUDA": "OFF",
        "alpaka_DEP_HIP": "OFF",
        "alpaka_DEP_ONEAPI": "OFF"
      },
      "environment": {
        "OMP_NUM_THREADS": "64"
      }
    },
    {
      "name": "hip",
      "displayName": "HIP backend for AMD gfx1100 (CMake 3.28 HIP preload workaround)",
      "description": "AMD HIP backend. Uses cmake/hip/hip_preload.cmake via CMAKE_PROJECT_INCLUDE because CMake 3.28 leaves the HIP compile rule unset when alpaka enables HIP. Knobs: -DALPAKA_HECBENCH_ROCM_ROOT (default /opt/rocm).",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_PROJECT_INCLUDE": "${sourceDir}/cmake/hip/hip_preload.cmake",
        "alpaka_DEP_HIP": "ON",
        "alpaka_DEP_CUDA": "OFF",
        "alpaka_DEP_ONEAPI": "OFF",
        "alpaka_DEP_OMP": "OFF",
        "CMAKE_HIP_ARCHITECTURES": "gfx1100",
        "CMAKE_HIP_COMPILER": "$env{ALPAKA_HECBENCH_ROCM_ROOT}/llvm/bin/clang++",
        "CMAKE_HIP_COMPILER_ROCM_ROOT": "$env{ALPAKA_HECBENCH_ROCM_ROOT}"
      }
    },
    {
      "name": "sycl",
      "displayName": "SYCL/oneAPI backend (spir64, FP32-only device; Intel Arc A770 has no FP64)",
      "description": "Intel oneAPI SYCL backend for the Arc A770 (SPIR64, FP32-only; the A770 has no fp64 aspect). alpaka_HOST_Cpu=OFF avoids an icpx 2026.1 Sema crash in the SYCL device pass on this source. Knobs: -DALPAKA_HECBENCH_ICX (icpx path), -DALPAKA_HECBENCH_ONEAPI_ROOT (oneAPI root).",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "$env{ALPAKA_HECBENCH_ICX}",
        "CMAKE_PREFIX_PATH": "$env{ALPAKA_HECBENCH_ONEAPI_ROOT}",
        "alpaka_DEP_ONEAPI": "ON",
        "alpaka_DEP_HIP": "OFF",
        "alpaka_DEP_CUDA": "OFF",
        "alpaka_DEP_OMP": "OFF",
        "alpaka_ONEAPI_Cpu": "OFF",
        "alpaka_HOST_Cpu": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "cpu",
      "configurePreset": "cpu"
    },
    {
      "name": "cpu-serial",
      "configurePreset": "cpu-serial"
    },
    {
      "name": "cuda",
      "configurePreset": "cuda"
    },
    {
      "name": "cpu-icpx",
      "configurePreset": "cpu-icpx",
      "targets": ["cross-alpaka"]
    },
    {
      "name": "hip",
      "configurePreset": "hip",
      "targets": ["cross-alpaka"]
    },
    {
      "name": "sycl",
      "configurePreset": "sycl",
      "targets": ["cross-alpaka"]
    }
  ]
}
